{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ube",
  "scopeName": "source.ube",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ube",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ube",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ube",
          "match": "\\b(class|trait|final|var|if|else|for|break|continue|switch|case|default|yield|return|import|as|is|with|in|async|await)\\b"
        },
        {
          "name": "keyword.operator.word.ube",
          "match": "\\b(not|and|nand|or|nor|xor|xnor)\\b"
        },
        {
          "name": "support.function.builtin.ube",
          "match": "\\b(print)\\b"
        },
        {
          "name": "variable.language.this.ube",
          "match": "\\bthis\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.ube",
          "match": "\\b(string|int|decimal|byte|long|bool)\\b"
        },
        {
          "name": "entity.name.type.class.ube",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.ube",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.ube",
          "match": "\\bnull\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ube",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ube",
              "match": "\\\\([\"\\\\ntr])"
            }
          ]
        },
        {
          "name": "string.quoted.backtick.ube",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.ube",
              "match": "\\\\([`\\\\ntr$])"
            },
            {
              "name": "meta.embedded.line.interpolation.ube",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.section.embedded.begin.ube" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.section.embedded.end.ube" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.decimal.ube",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.ube",
          "match": "\\b[0-9][0-9_]*[L] propuesta?\\b"
        },
        {
          "name": "constant.numeric.integer.ube",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.optional.ube",
          "match": "\\?\\.|\\?\\?=|\\?\\?"
        },
        {
          "name": "keyword.operator.range.ube",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.arrow.ube",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.ube",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.ube",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.ube",
          "match": "\\+|\\-|\\*|/|%"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.ube",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    }
  }
}
