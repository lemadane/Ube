{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ube",
  "scopeName": "source.ube",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ube",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ube",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ube",
          "match": "\\b(class|trait|try|catch|finally|throw|static|final|var|if|then|else|for|each|break|continue|switch|case|default|yield|return|use|as|is|with|from|async|await)\\b"
        },
        {
          "name": "keyword.operator.word.ube",
          "match": "\\b(not|and|or)\\b"
        },
        {
          "name": "support.function.builtin.ube",
          "match": "\\b(Log|Console)\\b"
        },
        {
          "name": "variable.language.this.ube",
          "match": "\\bthis\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.ube",
          "match": "\\b(string|int|decimal|byte|long|bool)\\b"
        },
        {
          "name": "entity.name.type.class.ube",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.ube",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.ube",
          "match": "\\bnull\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.other.backtick.ube",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.ube",
              "match": "\\\\(?:u\\{[0-9a-fA-F]+\\}|u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|.)"
            },
            {
              "name": "meta.interpolation.ube",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "#template-braces"
                },
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.ube",
          "begin": "'",
          "end": "(?<!\\\\)(?:\\\\\\\\)*'",
          "patterns": [
            {
              "name": "constant.character.escape.ube",
              "match": "\\\\(['\\\"\\\\ntr$])"
            }
          ]
        },
        {
          "name": "invalid.illegal.reserved-double-quote.ube",
          "match": "\""
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.decimal.ube",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.ube",
          "match": "\\b[0-9][0-9_]*[L] propuesta?\\b"
        },
        {
          "name": "constant.numeric.integer.ube",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.optional.ube",
          "match": "\\?\\.|\\?\\?=|\\?\\?"
        },
        {
          "name": "keyword.operator.range.ube",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.arrow.ube",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.ube",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.ube",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.ube",
          "match": "\\+|\\-|\\*|/|%"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.ube",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "template-braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#template-braces"
        },
        {
          "include": "$self"
        }
      ]
    }
  }
}
