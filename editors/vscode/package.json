{
  "name": "ube-vscode",
  "displayName": "Ube Language Support",
  "description": "Syntax highlighting, formatting, and language support for the Ube programming language (.ube)",
  "version": "0.6.0",
  "publisher": "ube-lang",
  "categories": [
    "Programming Languages"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:ube"
  ],
  "scripts": {
    "test": "node --test"
  },
  "contributes": {
    "configurationDefaults": {
      "[ube]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.defaultFormatter": "ube-lang.ube-vscode"
      }
    },
    "languages": [
      {
        "id": "ube",
        "aliases": [
          "Ube",
          "ube"
        ],
        "extensions": [
          ".ube"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ube",
        "scopeName": "source.ube",
        "path": "./syntaxes/ube.tmLanguage.json"
      }
    ]
  }
}
