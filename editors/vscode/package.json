{
  "name": "ube-vscode",
  "displayName": "Ube Language Support",
  "description": "Syntax highlighting, file recognition, and language support for the Ube programming language (.ube)",
  "version": "0.5.0",
  "publisher": "ube-lang",
  "icon": "icon.png",
  "categories": [
    "Programming Languages"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "ube",
        "aliases": [
          "Ube",
          "ube"
        ],
        "extensions": [
          ".ube"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ube",
        "scopeName": "source.ube",
        "path": "./syntaxes/ube.tmLanguage.json"
      }
    ]
  }
}
