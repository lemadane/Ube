class App {
    start() {
        final numbers = [10, 20, 30]

        each (number in numbers) {
            print(number)
        }

        each (index, number in numbers) {
            print('${index}: ${number}')
        }

        each (number in [0, 1, 2]) {
            if (number == 1) {
                continue
            }
            print(number)
        }

        final doubled = each (number in numbers) {
            yield number * 2
        }
        each (number in doubled) {
            print(number)
        }

        each (number in []) {
            print(number)
        } else {
            print('No items')
        }

        for (i = 0 to 10, by 3) {
            print(i)
        }

        final descending = for (i = 10 to 0, by -3) {
            yield i
        }
        each (value in descending) {
            print(value)
        }

        var remaining = 2
        while (remaining > 0) {
            print(remaining)
            remaining = remaining - 1
        }

        while {
            print('Done')
            break
        }
    }
}
