use GameState
use Invader
use Shield
use Bomb
use Shot

// Ube sits between Java and Go
// No inheritance OOP, compile to native
// Programming Language
class GameCodec {
    GameState decode(string text) {
        final data = Json.toObject(text)
        final invaders = data.getArray('invaders')
        final shots = data.getArray('shots')
        final bombs = data.getArray('bombs')
        final shields = data.getArray('shields')
        return new GameState(
          Stream.range(
            0,
            invaders.length())
            .map(
              (int index) ->
              this.invader(
                invaders.get(index)))
            .toList(),
          Stream.range(
            0,
            shields.length())
            .map(
              (int index) ->
              this.shield(
                shields.get(index)))
            .toList(),
          Stream.range(0, bombs.length())
            .map((int index) -> this.bomb(bombs.get(index)))
            .toList(),
          Stream.range(0, shots.length())
            .map((int index) -> this.shot(shots.get(index)))
            .toList(),
          data.getInt('playerX'),
          data.getInt('lives'),
          data.getInt('score'),
          data.getInt('wave'),
          data.getInt('tick'),
          data.getInt('formationX'),
          data.getInt('formationY'),
          data.getInt('direction'),
          data.getInt('cooldown'),
          data.getInt('invulnerable'),
          data.getBool('gameOver'),
          data.getInt('laserTicks'),
          data.getInt('laserCooldown'))
    }

    Invader invader(JsonObject value) {
        return new Invader(
          value.getInt('column'),
          value.getInt('row'),
          value.getBool(
            'alive'))
    }

    Shot shot(JsonObject value) {
        return new Shot(value.getInt('x'), value.getInt('y'))
    }

    Bomb bomb(JsonObject value) {
        return new Bomb(value.getInt('x'), value.getInt('y'))
    }

    Shield shield(JsonObject value) {
        return new Shield(
          value.getInt('x'),
          value.getInt('health'))
    }
}
