use GameState
use Invader
use Bomb
use Shot

// One call advances exactly 1/30 second. Integer coordinates keep pixels crisp.
class GameRules {
    static final int width = 384
    static final int playerY = 258
    static final int shieldY = 224

    void advance(
      GameState game,
      int movement,
      bool firing) {
        this.advanceWeapons(game, movement, firing, false)
    }

    void advanceWeapons(GameState game, int movement, bool firing, bool laser) {
        if (game.gameOver()) {
            return
        }
        game.tick(
          game.tick() + 1)
        if (game.invulnerable() > 0) {
            game.invulnerable(
              game.invulnerable() - 1)
        }
        if (game.cooldown() > 0) {
            game.cooldown(
              game.cooldown() - 1)
        }
        this.movePlayer(
          game,
          movement)
        this.moveFormation(game)
        if (game.gameOver()) {
            return
        }
        this.fireLaser(game, laser)
        this.firePlayer(
          game,
          firing)
        each (shot in game.shots()) { this.movePlayerShot(game, shot) }
        this.moveEnemyBombs(game)
        if (game.lives() <= 0) {
            game.gameOver(true)
        }
        if (not game.gameOver()
          and game.invaders()
          .stream()
          .none(
            (Invader enemy) -> enemy.alive())) {
            this.nextWave(game)
        }
    }

    // At 30 ticks/second: one second of beam, ten seconds between activations.
    // The piercing beam passes through shields and follows the center cannon.
    void fireLaser(GameState game, bool trigger) {
        if (game.laserTicks() > 0) {
            game.laserTicks(game.laserTicks() - 1)
        }
        if (game.laserCooldown() > 0) {
            game.laserCooldown(game.laserCooldown() - 1)
        }
        if (trigger and game.laserCooldown() == 0) {
            game.laserTicks(30)
            game.laserCooldown(300)
        }
        if (game.laserTicks() == 0) {
            return
        }
        each (enemy in game.invaders()) {
            final x = this.enemyX(game, enemy)
            if (enemy.alive()
              and x >= game.playerX() - 13
              and x <= game.playerX() + 13
              and this.enemyY(game, enemy) < static.playerY - 6) {
                enemy.alive(false)
                game.score(game.score()
                  + (enemy.row() == 0 then 30 else (
                    enemy.row() < 3 then 20 else 10)))
            }
        }
    }

    void movePlayer(
      GameState game,
      int movement) {
        final next = game.playerX() + movement * 4
        game.playerX(
          next < 12 then 12 else (
            next > static.width - 12 then static.width - 12 else next))
    }

    int enemyX(
      GameState game,
      Invader enemy) {
        return 64 + enemy.column() * 32 + game.formationX()
    }

    int enemyY(
      GameState game,
      Invader enemy) {
        return 48 + enemy.row() * 22 + game.formationY()
    }

    void moveFormation(GameState game) {
        final interval = game.wave() < 10 then 16 - game.wave() else 6
        if (game.tick() % interval != 0) {
            return
        }
        var edge = false
        each (enemy in game.invaders()) {
            if (enemy.alive()) {
                final next = this.enemyX(
                  game,
                  enemy) + game.direction() * 4
                if (next < 16
                  or next > 368) {
                    edge = true
                }
            }
        }
        if (edge) {
            game.direction(
              0 - game.direction())
            game.formationY(
              game.formationY() + 10)
        } else {
            game.formationX(
              game.formationX() + game.direction() * 4)
        }
        each (enemy in game.invaders()) {
            if (enemy.alive()
              and this.enemyY(
              game,
              enemy) >= 244) {
                game.gameOver(true)
            }
        }
    }

    void firePlayer(
      GameState game,
      bool firing) {
        if (firing
          and game.shots().stream().every((Shot shot) -> shot.y() < 0)
          and game.cooldown() == 0) {
            game.shots().get(0).x(game.playerX() - 9)
            game.shots().get(1).x(game.playerX() + 9)
            each (shot in game.shots()) { shot.y(static.playerY - 4) }
            game.cooldown(8)
        }
    }

    bool touches(
      int x,
      int y,
      int centerX,
      int centerY,
      int halfWidth,
      int halfHeight) {
        return x >= centerX - halfWidth and x <= centerX + halfWidth
        and y >= centerY - halfHeight and y <= centerY + halfHeight
    }

    bool hitShield(
      GameState game,
      int x,
      int y) {
        each (shield in game.shields()) {
            if (shield.health() > 0
              and this.touches(
              x,
              y,
              shield.x(),
              static.shieldY,
              12,
              7)) {
                shield.health(
                  shield.health() - 1)
                return true
            }
        }
        return false
    }

    void movePlayerShot(GameState game, Shot shot) {
        if (shot.y() < 0) {
            return
        }
        shot.y(
          shot.y() - 8)
        if (this.hitShield(
          game,
          shot.x(),
          shot.y())) {
            shot.y(-1)
            return
        }
        each (enemy in game.invaders()) {
            if (enemy.alive()
              and this.touches(
              shot.x(),
              shot.y(),
              this.enemyX(
                game,
                enemy),
              this.enemyY(
                game,
                enemy),
              11,
              7)) {
                enemy.alive(false)
                game.score(
                  game.score()
                  + (enemy.row() == 0 then 30 else (
                    enemy.row() < 3 then 20 else 10)))
                shot.y(-1)
                return
            }
        }
    }

    // Fire from up to three distinct occupied columns every 24 ticks.
    // Six reusable slots bound the number of bombs and the serialized state.
    void moveEnemyBombs(GameState game) {
        if (game.tick() % 24 == 0) {
            var launched = 0
            each (offset in Stream.range(0, 8).toList()) {
                if (launched < 3) {
                    final column = (game.tick() / 24 + offset) % 8
                    var bottom = -1
                    var x = 0
                    each (enemy in game.invaders()) {
                        if (enemy.alive() and enemy.column() == column) {
                            final y = this.enemyY(game, enemy)
                            if (y > bottom) {
                                bottom = y
                                x = this.enemyX(game, enemy)
                            }
                        }
                    }
                    if (bottom >= 0) {
                        var placed = false
                        each (bomb in game.bombs()) {
                            if (not placed and bomb.y() < 0) {
                                bomb.x(x)
                                bomb.y(bottom + 9)
                                placed = true
                                launched = launched + 1
                            }
                        }
                    }
                }
            }
        }
        each (bomb in game.bombs()) {
            this.moveBomb(game, bomb)
        }
    }

    void moveBomb(GameState game, Bomb bomb) {
        if (bomb.y() < 0) {
            return
        }
        bomb.y(bomb.y() + 4)
        if (bomb.y() > 280
          or this.hitShield(game, bomb.x(), bomb.y())) {
            bomb.y(-1)
            return
        }
        if (this.touches(bomb.x(), bomb.y(), game.playerX(), static.playerY, 10, 7)) {
            bomb.y(-1)
            if (game.invulnerable() == 0) {
                game.lives(game.lives() - 1)
                game.invulnerable(45)
            }
        }
    }

    void nextWave(GameState game) {
        game.laserTicks(0)
        game.wave(
          game.wave() + 1)
        game.formationX(0)
        game.formationY(0)
        game.direction(1)
        each (shot in game.shots()) { shot.y(-1) }
        each (bomb in game.bombs()) { bomb.y(-1) }
        game.invulnerable(45)
        each (enemy in game.invaders()) {
            enemy.alive(true)
        }
        each (shield in game.shields()) {
            shield.health(4)
        }
    }
}
