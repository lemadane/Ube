use GameFactory
use GameCodec
use GameRules

// The browser sends only controls. The session owns the authoritative state.
class GameController(Channel<int> turns) {
    Response reset(Request request) {
        return Async.start(() -> this.update(request, true)).await()
    }

    Response step(Request request) {
        return Async.start(() -> this.update(request, false)).await()
    }

    // Keep read, simulation, and write together, including resets from other tabs.
    // Always return the token, including when decoding or simulation throws.
    Response update(Request request, bool reset) {
        final token = this.turns().receive().await()
        try {
            if (reset) {
                return this.resetState(request)
            }
            return this.stepState(request)
        } finally {
            this.turns().send(token).await()
        }
    }

    Response resetState(Request request) {
        final game = new GameFactory()
          .create()
        final snapshot = game.toJson()
        request.session()
          .set(
            'space-invaders',
            snapshot)
        return Response.json(snapshot)
    }

    Response stepState(Request request) {
        final session = request.session()
        final saved = session.get('space-invaders')
        if (saved == null) {
            return this.resetState(request)
        }
        final game = new GameCodec()
          .decode(saved else '')
        final direction = request.query('move')
        final movement = direction == 'left' then -1 else (
          direction == 'right' then 1 else 0)
        new GameRules()
          .advanceWeapons(
            game,
            movement,
            request.query('fire') == '1',
            request.query('laser') == '1')
        final snapshot = game.toJson()
        session.set(
          'space-invaders',
          snapshot)
        return Response.json(snapshot)
    }
}
