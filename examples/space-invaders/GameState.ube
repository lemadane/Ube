use Invader
use Shield

// Serializable domain state; no HTTP, canvas, or input-device dependencies.
class GameState(
    List<Invader> invaders,
    List<Shield> shields,
    var int playerX = 192,
    var int lives = 3,
    var int score = 0,
    var int wave = 1,
    var int tick = 0,
    var int formationX = 0,
    var int formationY = 0,
    var int direction = 1,
    var int shotX = 0,
    var int shotY = -1,
    var int enemyShotX = 0,
    var int enemyShotY = -1,
    var int cooldown = 0,
    var int invulnerable = 0,
    var bool gameOver = false)
