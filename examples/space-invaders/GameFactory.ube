use GameState
use Invader
use Shield
use Bomb
use Shot

class GameFactory {
    GameState create() {
        final invaders = Stream.range(
          0,
          40)
          .map(
            (int cell) -> new Invader(
              cell % 8,
              cell / 8))
          .toList()
        final shields = Stream.range(
          0,
          3)
          .map(
            (int index) -> new Shield(80 + index * 112))
          .toList()
        return new GameState(
          invaders,
          shields,
          Stream.range(0, 6)
            .map((int index) -> new Bomb())
            .toList(),
          Stream.range(0, 2)
            .map((int index) -> new Shot())
            .toList())
    }
}
