class App {

    // Increment a counter in the cache many times.
    int incrementMany(
      Cache cache,
      int iterations) {
        var index = 0
        for (index < iterations) {
            cache.increment(
              'count',
              1)
            index = index + 1
        }
        return iterations
    }

    // The entry point of the application.
    start() {
        final cache = Cache.memory(4096)
        try {
            cache.set(
              'count',
              '0',
              0)
            final first = Async.start(
              () -> this.incrementMany(
                cache,
                100))
            final second = Async.start(
              () -> this.incrementMany(
                cache,
                100))
            first.await()
            second.await()
            Console.printLine(
              cache.get('count')
                ?? 'missing')
        } finally {
            cache.close()
        }
    }
}
