class Application {
    main() {
        Log.put('requestId', 'req-42')
        try {
            log('Processing request')
            string? requestId = Log.get('requestId')
            Console.printLine(requestId ?? 'unknown')

            Log.put('user', 'alice')
            Log.warn('Retrying operation')
            Log.remove('user')
        } finally {
            Log.clear()
        }
        Log.info('Context cleared')
    }
}
