// Bounded UTF-8 file transfer using the currently implemented HTTP APIs.
// Run in a private directory. See README.md for TLS setup and current limits.
class FileTransferApplication {
    start() {
        final server = Server()
        Directory.create('uploads')
        final filePath = 'uploads/example.txt'

        if (File.exists('cert.pem')
          and File.exists('key.pem')) {
            server.tls(
              'cert.pem',
              'key.pem')
            server.enableHttp2()
            server.enableHttp3(8443)
        }

        server.post(
          '/files/example.txt',
          (Request request) -> {
              File.write(
                filePath,
                request.body())
              return Response.json(
                [
                'success': true,
                'file': 'example.txt',
                'size': File.info(filePath)
                  .size(),
                'protocol': request.protocol()
                ].toJson())
          })

        server.get(
          '/files/example.txt',
          (Request request) -> {
              if (not File.exists(filePath)) {
                  return Response.notFound('File not found')
              }
              return Response.text(
                File.read(filePath))
          })

        server.get(
          '/files/example.txt/info',
          (Request request) -> {
              if (not File.exists(filePath)) {
                  return Response.notFound('File not found')
              }
              return Response.json(
                [
                'file': 'example.txt',
                'size': File.info(filePath)
                  .size()
                ].toJson())
          })

        server.delete(
          '/files/example.txt',
          (Request request) -> {
              if (not File.exists(filePath)) {
                  return Response.notFound('File not found')
              }
              File.delete(filePath)
              return Response.ok('Deleted example.txt')
          })
        server.start(8443)
    }
}
